spec_version: v1.18
identifier: BDArmory-Overdrive
name: BDArmory Overdrive
abstract: >-
  BDArmory Plus 1.13.1 with bug fixes and improvements: up to 1024 targets and 128 missiles
  per target, missile retargeting, parallel salvos, depth-charge release over submarines and
  memory-leak fixes for long battles. Drop-in replacement for BDArmory Plus.
author:
  - BahamutoD
  - Papa_Joe
  - jrodrigv
  - DocNappers
  - SuicidalInsanity
  - josue
  - BillNyeTheIE
  - Gedas-S
  - Skizzy-create
$kref: '#/ckan/github/Skizzy-create/BDArmory/asset_match/BDArmoryOverdrive-.*\.zip'
$vref: '#/ckan/ksp-avc'
x_netkan_epoch: 2
x_netkan_force_v: true
license: CC-BY-SA-2.0
resources:
  homepage: https://github.com/Skizzy-create/BDArmory/tree/multitarget-1.13.1
  repository: https://github.com/Skizzy-create/BDArmory
  bugtracker: https://github.com/Skizzy-create/BDArmory/issues
  x_upstream: https://github.com/BrettRyland/BDArmory
tags:
  - plugin
  - parts
  - sound
  - combat
provides:
  - BDArmory
  - BDArmoryForRunwayProject
conflicts:
  - name: BDArmory
  - name: BDArmoryForRunwayProject
depends:
  - name: ModuleManager
  - name: PhysicsRangeExtender
install:
  - find: BDArmory
    install_to: GameData
  - find: craft
    install_to: Ships
    as: SPH
